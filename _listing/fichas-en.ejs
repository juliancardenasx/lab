<%
const kinds = {preprint: "Preprint", articulo: "Article", capitulo: "Book chapter", informe: "Report", datos: "Data", skill: "Skill", plugin: "Plugin", conector: "Connector", video: "Video"};
const plat = (item) => item.plataformas ? " · " + [].concat(item.plataformas).join(", ") : "";
const btn = (url, label) => url ? `<a class="nw-btn" href="${url}">${label}</a>` : "";
const doiUrl = (d) => d ? (d.startsWith("http") ? d : "https://doi.org/" + d) : null;
const meta = (item) => [item.autores, item.date ? `<span class="listing-date">${item.date}</span>` : null, item.revista ? `<em>${item.revista}</em>` : null].filter(Boolean).join(" · ");
%>
<% if (items.length === 0) { %>
<p class="nw-empty">Nothing here yet. Coming soon.</p>
<% } else { %>
<ul class="nw-list">
<% for (const item of items) { %>
<li class="nw-item<% if (item.image) { %> nw-has-cover<% } %>" <%= metadataAttrs(item) %>><% if (item.image) { %><a class="nw-thumb" href="<%= item.path %>"><img src="<%= item.image %>" alt="" loading="lazy"></a><% } %><div class="nw-item-body"><% if (item.tipo) { %><div class="nw-kicker"><%- (kinds[item.tipo] || item.tipo) + (["skill","plugin","conector"].includes(item.tipo) ? plat(item) : "") %></div><% } %><h3><a href="<%= item.path %>"><%- item.title %></a></h3><div class="nw-meta"><%= meta(item) %></div><% if (item.description) { %><p class="nw-desc"><%- item.description %></p><% } %><div class="nw-links"><%= btn(doiUrl(item.doi), "DOI") %><%= btn(item.pdf, "PDF") %><%= btn(item.datos, "Data") %><%= btn(item.codigo, "Code") %><%= btn(item.youtube, "Video") %></div></div></li>
<% } %>
</ul>
<% } %>
